<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <title>Sculptly Terms of Use</title>
  <meta name="description" content="Terms of Use for the Sculptly workout app." />
  <style>
    :root {
      --bg: #fffaf7;
      --card: #ffffff;
      --text: #1f1d1d;
      --muted: #746d6d;
      --accent: #f65a78;
      --accent-soft: #ffe8ee;
      --border: #f0e4e0;
      --shadow: 0 14px 40px rgba(72, 43, 48, 0.08);
      --radius: 22px;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background:
        radial-gradient(circle at top right, #ffeef2 0, transparent 30%),
        linear-gradient(180deg, #fffaf7 0%, #fffdfb 100%);
      color: var(--text);
      line-height: 1.68;
      -webkit-font-smoothing: antialiased;
    }

    .wrap {
      width: min(920px, calc(100% - 32px));
      margin: 0 auto;
      padding: 56px 0 72px;
    }

    .hero {
      background: linear-gradient(135deg, #fff 0%, #fff5f7 100%);
      border: 1px solid var(--border);
      border-radius: 30px;
      padding: 42px;
      box-shadow: var(--shadow);
      margin-bottom: 26px;
    }

    .eyebrow {
      display: inline-block;
      padding: 7px 11px;
      border-radius: 999px;
      background: var(--accent-soft);
      color: var(--accent);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
      margin-bottom: 18px;
    }

    h1 {
      margin: 0 0 12px;
      font-size: clamp(38px, 6vw, 64px);
      line-height: 1.02;
      letter-spacing: -0.04em;
    }

    .subtitle {
      margin: 0;
      color: var(--muted);
      font-size: 18px;
      max-width: 720px;
    }

    .meta {
      margin-top: 22px;
      font-size: 14px;
      color: var(--muted);
    }

    .toc, section {
      background: rgba(255,255,255,.92);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 28px 30px;
      margin: 18px 0;
    }

    .toc h2, section h2 {
      margin-top: 0;
    }

    .toc a {
      color: var(--text);
      text-decoration: none;
      display: inline-block;
      margin: 5px 14px 5px 0;
      font-weight: 600;
    }

    .toc a:hover { color: var(--accent); }

    h2 {
      font-size: 25px;
      line-height: 1.25;
      letter-spacing: -0.02em;
      margin-bottom: 12px;
    }

    h3 {
      font-size: 18px;
      margin: 22px 0 8px;
    }

    p, li { color: #4f4949; }
    ul { padding-left: 22px; }
    li + li { margin-top: 7px; }
    strong { color: var(--text); }

    .callout {
      background: var(--accent-soft);
      border-radius: 16px;
      padding: 16px 18px;
      color: #5f454a;
      margin: 16px 0 0;
    }

    footer {
      color: var(--muted);
      font-size: 13px;
      text-align: center;
      padding: 24px 10px 0;
    }

    @media (max-width: 640px) {
      .wrap {
        width: min(100% - 20px, 920px);
        padding-top: 18px;
      }

      .hero, .toc, section {
        padding: 22px 20px;
        border-radius: 20px;
      }

      .hero { padding-top: 28px; }
      h2 { font-size: 22px; }
    }
  </style>
</head>
